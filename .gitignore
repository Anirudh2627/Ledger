results/*
!results/.gitkeep
!results/example/
experiments/*
!experiments/.gitkeep
!experiments/index.example.jsonl
reports/*
!reports/.gitkeep
!reports/example/

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Docker ---
.docker/
