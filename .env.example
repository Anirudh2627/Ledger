# =============================================================================
# Ledger - environment configuration TEMPLATE
# =============================================================================
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# NEVER commit real API keys. Every value below is optional in mock mode -
# Ledger runs fully offline with the deterministic mock provider by default.
#
# Precedence: process environment > .env file > YAML config defaults.
# YAML config files may only reference keys indirectly via `api_key_env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Provider for the System Under Test (SUT) - any OpenAI-compatible API
# (OpenAI, Azure OpenAI, Anthropic via proxy, vLLM, Ollama, LiteLLM, TGI, ...)
# -----------------------------------------------------------------------------
LEDGER_PROVIDER_API_KEY=
LEDGER_PROVIDER_BASE_URL=https://api.openai.com/v1
LEDGER_PROVIDER_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Provider for the LLM judge (recommended: a DIFFERENT/stronger model than the
# SUT to reduce self-preference bias; leave empty to reuse the SUT provider)
# -----------------------------------------------------------------------------
LEDGER_JUDGE_API_KEY=
LEDGER_JUDGE_BASE_URL=https://api.openai.com/v1
LEDGER_JUDGE_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Optional: embedding provider for the sample RAG system.
# Leave empty to use the built-in deterministic offline hashing embedder.
# -----------------------------------------------------------------------------
LEDGER_EMBEDDING_API_KEY=
LEDGER_EMBEDDING_BASE_URL=https://api.openai.com/v1
LEDGER_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Generic fallbacks honored by config files through `api_key_env` references
# (e.g. a config can say: api_key_env: OPENAI_API_KEY)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Runtime behavior
# -----------------------------------------------------------------------------
# Force the whole stack (SUT provider + judge) into deterministic mock mode,
# regardless of what config files say. Used by CI's default offline path.
LEDGER_FORCE_MOCK=0

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LEDGER_LOG_LEVEL=INFO
